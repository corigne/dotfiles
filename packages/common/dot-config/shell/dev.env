# Development environment shared across desktop profiles.
export EDITOR="/usr/bin/nvim"
export VISUAL="nvim"

export DEVKITPRO="/opt/devkitpro"
export DEVKITARM="/opt/devkitpro/devkitARM"
export DEVKITPPC="/opt/devkitpro/devkitPPC"

export PATH="$HOME/.local/share/fnm:$PATH"
export PATH="/opt/cisco/anyconnect/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

export GEM_HOME="$(gem env user_gemhome)"
export PATH="$PATH:$GEM_HOME/bin"

export PATH="$HOME/perl5/bin${PATH:+:${PATH}}"
export PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"
export PERL_LOCAL_LIB_ROOT="$HOME/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"
export PERL_MB_OPT="--install_base \"$HOME/perl5\""
export PERL_MM_OPT="INSTALL_BASE=$HOME/perl5"

export LD_LIBRARY_PATH="/usr/local/pgsql/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export PATH="/usr/local/pgsql/bin:$PATH"

export GOPATH="$HOME/dev/go"
export GOBIN="/usr/local/go/bin"
export PATH="$PATH:$GOBIN:$GOPATH/bin"

export PATH="$HOME/.cargo/bin:$PATH"

export ANDROID_HOME="/opt/android-sdk"
export ANDROID_NDK_HOME="/opt/android-ndk"
export ANDROID_NDK_ROOT="/opt/android-ndk"
export PATH="$PATH:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/emulator:${ANDROID_NDK_HOME}"
