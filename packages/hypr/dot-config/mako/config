# General
#########

sort=-time
layer=overlay
default-timeout=7500
ignore-timeout=1

# Visual
########
font=Maple Mono NF CN 10
width=400
height=160
border-size=2
border-radius=6
max-icon-size=96
#icons=0

# Colors
########
background-color=#303446
text-color=#c6d0f5
border-color=#8caaee
progress-color=over #414559

[urgency=high]
border-color=#ef9f76
default-timeout=0

[category=mpd]
default-timeout=3500
group-by=category

[app-name=pasystray]
group-by=app-name
default-timeout=1000
